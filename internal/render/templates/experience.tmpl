<<- if has $c "project" >>
\noindent{\fontsize{9.5}{10.5}\selectfont\textbf{<< if has $c "projectUrl" >>\href{<< href (str $c "projectUrl") >>}{<< tex (str $c "project") >>}<< else >><< tex (str $c "project") >><< end >>}}
